{
  "name": "travel-talk",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/emit-vosk-worker.mjs",
    "dev": "rsbuild dev",
    "prebuild": "node scripts/emit-vosk-worker.mjs",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/emit-vosk-worker.mjs",
    "test": "vitest run",
    "test:overflow": "playwright test",
    "test:clips": "vitest run --config vitest.clips.config.ts",
    "lint": "eslint .",
    "export-speech": "tsx tools/export-speech.ts"
  },
  "dependencies": {
    "dexie": "4.4.6",
    "pitchy": "4.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "ts-fsrs": "5.4.2",
    "vosk-browser": "0.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@rsbuild/core": "2.3.3",
    "@rsbuild/plugin-react": "2.1.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "21.0.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.0.3",
    "workbox-build": "7.4.1"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "overrides": {
      "glob@>=9 <14.0.2": "14.0.2",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "serialize-javascript@<7.1.3": "7.1.3",
      "uuid@<11.1.1": "11.1.1"
    }
  }
}
